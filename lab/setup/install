#!/usr/bin/env bash
# Runs once, when the codespace is created: downloads the app's images,
# installs Twenty's dependencies, builds the screens the ready-built app sends,
# and trims the history to the last 50 commits.
# It writes how long each part took, and the codespace's size, to
# lab/setup-times.log.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/env.sh"

LOG="$LAB_DIR/setup-times.log"
began=$(date +%s)
stamp() { echo "$1 after $(( $(date +%s) - began ))s" | tee -a "$LOG"; }

trap 'echo; echo "Setup didn'"'"'t finish. Take a screenshot of this terminal and send it to us."' ERR

container_started=$(date -u -d "$(ps -o lstart= -p 1)" +%FT%TZ 2>/dev/null || echo "unknown")
memory_gb=$(awk '/^MemTotal:/ {printf "%d", $2 / 1048576}' /proc/meminfo)
{
  echo "Container started $container_started"
  echo "Setup started $(date -u +%FT%TZ)"
  echo "Machine: $(nproc) cores, $memory_gb GB memory"
} | tee "$LOG"

echo "Setting up your codespace. The first time, this takes several minutes."

for _ in $(seq 1 60); do
  docker info >/dev/null 2>&1 && break
  sleep 2
done

( docker compose pull --quiet && stamp "Downloaded the app's images" ) &
images=$!

(
  cd "$REPO_DIR"
  yarn install
  stamp "Installed the frontend's dependencies"
  npx nx run-many -t build -p twenty-shared twenty-ui twenty-front-component-renderer
  stamp "Built the packages the frontend uses"
  NODE_OPTIONS=--max-old-space-size=8192 npx nx build twenty-front
  stamp "Built the ready-built app's screens"
  # Port 3001 starts from the same screens, so start-frontend is ready at once.
  rm -rf "$LAB_DIR/.frontend-from-source"
  cp -r packages/twenty-front/build "$LAB_DIR/.frontend-from-source"
) &
dependencies=$!

# Keep the last 50 commits, enough to follow a change back through the
# history, and drop the rest to save about 2 GB of the learner's storage.
(
  cd "$REPO_DIR"
  git fetch --quiet --depth=50 origin main
  git reflog expire --expire=now --all
  git gc --quiet --prune=now
  stamp "Trimmed the history to the last 50 commits"
) &
history=$!

wait "$images"
wait "$dependencies"
wait "$history"

# Yarn's package cache is only needed while installing, and takes about 4 GB.
(cd "$REPO_DIR" && yarn cache clean --all >/dev/null)
stamp "Emptied the package cache"

stamp "Setup finished"
echo "Codespace size: $(df -h /workspaces | awk 'NR == 2 {print $3 " used of " $2}')" | tee -a "$LOG"

echo
echo "Setup is finished. You can't type in this terminal, so open a new one with the + at the top right of this panel."
echo "Then type start-app and press Enter to start Twenty."
