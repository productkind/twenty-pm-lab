#!/usr/bin/env bash
# start-app: starts the ready-built app, the same package customers' servers
# run, then shows the server's log.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../setup/env.sh"

if [ ! -f "$REPO_DIR/packages/twenty-front/build/index.html" ]; then
  echo "The ready-built app's screens are missing, so setup didn't finish. Take a screenshot of this message and send it to us."
  exit 1
fi

echo "Starting the database, Redis, the server and the worker."
echo "The first start sets up the database, which takes a few minutes."
echo
docker compose up --detach

(
  until [ "$(docker inspect --format '{{.State.Health.Status}}' "$(docker compose ps -q server)" 2>/dev/null)" = "healthy" ]; do
    sleep 3
  done
  echo
  echo "Twenty is ready. The ready-built app is on port 3000: $SERVER_URL"
  echo "Next, run load-story in a new terminal (only the first time), then start-frontend."
  echo
) &

echo "The server's log follows. Leave this terminal open."
echo "Ctrl+C stops the log, not the app. To see another part's log, run show-log worker, show-log db or show-log redis in a new terminal."
echo
exec docker compose logs --follow server
